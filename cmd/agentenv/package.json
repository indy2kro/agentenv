{
  "name": "@indy2kro/agentenv",
  "version": "1.0.2",
  "description": "CLI for configuring a consistent, capable shell environment for AI coding agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentenv": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indy2kro/agentenv.git"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev src/index.ts",
    "test": "npm run build && cd dist && node --test",
    "test:coverage": "npm run build && cd dist && node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=80 --test",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:real": "npm run build && node scripts/smoke.mjs --real",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "cd ../.. && husky"
  },
  "keywords": [
    "ai",
    "coding",
    "agents",
    "claude",
    "copilot",
    "codex",
    "opencode",
    "environment",
    "mise",
    "rtk"
  ],
  "author": "Cristian Radu <indy2kro@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "toml": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ]
  }
}
